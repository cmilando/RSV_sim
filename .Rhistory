out_df <- subset(x_df_agg, test_mean_pt_sum > 0)
out_df$lambda <- lambda_guess
out_df
out_df <- true_contact_mat[
out_df, on = c('ref_age', 'contact_age')
]
out_df
return(out_df)
}
