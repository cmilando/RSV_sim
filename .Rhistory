out <- get_timeseries(
df_mat,
ta_mat,
hh_V     = 10,
school_V = 100,
work_V   = 100,
comm_V   = 100,
n_days = as.integer(2),
max_comm = as.integer(max(pop_df$community_id)),
max_school =  as.integer(max(pop_df$school_id)),
max_hh = as.integer(max(pop_df$household_id)),
max_work = as.integer(max(pop_df$work_id))
)
conc = out$hh[1, ]
conc
plot(conc, type = 'l', col = 'blue')
hhdt = data.table(conc, hour = 1:length(conc))
library(ggplot2)
hhdt
ggplot(hhdt) +
geom_line(aes(x = hour, y = conc))
library(ggpubr)
ggplot(hhdt) + theme_minimal() +
geom_line(aes(x = hour, y = conc))
ggplot(hhdt) + theme_classic2() +
geom_line(aes(x = hour, y = conc))
ggplot(hhdt) + theme_classic2() +
geom_line(aes(x = hour, y = conc), color = 'blue')
hhdt = data.table(conc, hour = 0:(length(conc) - 1))
ggplot(hhdt) + theme_classic2() +
geom_line(aes(x = hour, y = conc), color = 'blue') +
geom_vline(xintercept = c(8, 17, 24 ))
ggplot(hhdt) + theme_classic2() +
geom_line(aes(x = hour, y = conc), color = 'blue') +
geom_vline(xintercept = c(8, 17, 23 + 8))
ggplot(hhdt) + theme_classic2() +
geom_line(aes(x = hour, y = conc), color = 'blue') +
geom_vline(xintercept = c(8, 17, 23 + 8, 23 + 17))
ggplot(hhdt) + theme_classic2() +
geom_line(aes(x = hour, y = conc), color = 'blue') +
geom_vline(xintercept = c(8, 17, 23 + 8, 24 + 17))
ggplot(hhdt) + theme_classic2() +
geom_line(aes(x = hour, y = conc), color = 'blue') +
geom_vline(xintercept = c(8, 17, 23 + 8, 24 + 17),
linetype = 'dashed', linewidth = 0.25)
ggplot(hhdt) + theme_classic2() +
geom_line(aes(x = hour, y = conc), color = 'blue') +
geom_vline(xintercept = c(7, 17, 23 + 8, 24 + 17),
linetype = 'dashed', linewidth = 0.25)
ggplot(hhdt) + theme_classic2() +
geom_line(aes(x = hour, y = conc), color = 'blue') +
geom_vline(xintercept = c(7, 17, 23 + 8, 24 + 17),
linetype = 'dashed', linewidth = 0.25) +
ggtitle("household RSV concentration")
Rcpp::sourceCpp("get_timeseries.cpp")
out <- get_timeseries(
df_mat,
ta_mat,
hh_V     = 10,  # m^3
school_V = 100, # m^3
work_V   = 100, # m^3
comm_V   = 100, # m^3
n_days = as.integer(2),
max_comm = as.integer(max(pop_df$community_id)),
max_school =  as.integer(max(pop_df$school_id)),
max_hh = as.integer(max(pop_df$household_id)),
max_work = as.integer(max(pop_df$work_id))
)
